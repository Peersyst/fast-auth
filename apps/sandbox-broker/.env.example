CONFIG_ENV=development
APP_PORT=3000
# The broker's own origin. Auth0 sends users back to its /callback, and dApps use its host as their Auth0 domain.
PUBLIC_URL=http://localhost:3000

# The sandbox tenant. The broker refuses to start on a production tenant.
AUTH0_DOMAIN=login.testnet.fast-auth.com
# The broker's Regular Web Application, see the README.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# AUTH0_TIMEOUT_MS=10000

# How long a sign-in may take, how long a dApp has to redeem its code, and the most of each held in memory.
# FLOW_TTL_MS=600000
# CODE_TTL_MS=60000
# MAX_PENDING=10000
