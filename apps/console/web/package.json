{
    "name": "console-web",
    "version": "0.0.0",
    "description": "NEAR Auth Console SPA",
    "private": true,
    "type": "module",
    "scripts": {
        "gen:api": "openapi-typescript ../openapi-spec.json -o src/api/schema.gen.ts",
        "dev": "vite",
        "build": "pnpm gen:api && tsc --noEmit && vite build",
        "clean": "rimraf .turbo dist node_modules",
        "test": "jest --maxWorkers=30%",
        "lint": "pnpm gen:api && eslint .",
        "check-types": "pnpm gen:api && tsc --noEmit"
    },
    "dependencies": {
        "@auth0/auth0-react": "2.28.2",
        "@hookform/resolvers": "5.9.2",
        "@shared/console-domain": "workspace:*",
        "@shared/core": "workspace:*",
        "@tanstack/react-query": "5.104.5",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "openapi-fetch": "0.17.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-hook-form": "7.90.0",
        "react-router-dom": "7.18.4",
        "tailwind-merge": "3.7.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@shared/eslint": "workspace:*",
        "@shared/tsconfig": "workspace:*",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "6.10.0",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/jest": "29.5.14",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "4.7.0",
        "eslint": "8.57.0",
        "identity-obj-proxy": "3.0.0",
        "jest": "29.7.0",
        "jest-environment-jsdom": "29.7.0",
        "openapi-typescript": "7.13.0",
        "rimraf": "6.1.3",
        "tailwindcss": "4.3.3",
        "ts-jest": "29.4.15",
        "typescript": "5.9.3",
        "vite": "6.4.4"
    }
}
