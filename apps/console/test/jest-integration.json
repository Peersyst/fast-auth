{
    "testEnvironment": "node",
    "moduleFileExtensions": ["js", "ts"],
    "rootDir": ".",
    "testRegex": "integration/.*\\.spec\\.ts$",
    "transform": {
        "^.+\\.(ts|js)$": "ts-jest"
    },
    "transformIgnorePatterns": ["/node_modules/(?!(.+/)?(near-api-js|@noble/curves|@noble/hashes|@noble/ciphers|@scure/base))"],
    "globalSetup": "./integration/setup.ts",
    "globalTeardown": "./integration/teardown.ts"
}
