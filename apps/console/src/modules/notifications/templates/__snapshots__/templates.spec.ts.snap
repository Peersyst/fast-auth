exports[`email templates renders the subject and text of dapp_approved 1`] = `
{
  "subject": "Your dApp is approved on NEAR Auth",
  "text": "NEAR Auth

Your dApp is approved

Acme Wallet is approved. Its client id is:

    abcDEF123

Pass it to the NEAR Auth JavaScript provider on testnet. The login domain and signing audience are set from the network by default:

    import { JavascriptProvider } from "@fast-auth-near/javascript-provider";

    const provider = new JavascriptProvider({
        network: "testnet",
        clientId: "abcDEF123",
    });

Use one of the callback URLs you registered as your redirect URI.

Read the authentication guide: https://docs.auth.near.org/home/guides/authenticate-users

Open the NEAR Auth Console: https://console.example.test/

Sent by the NEAR Auth Console.
",
}
`;

exports[`email templates renders the subject and text of dapp_rejected 1`] = `
{
  "subject": "Your dApp needs changes before approval",
  "text": "NEAR Auth

Your dApp needs changes

Acme Wallet needs changes before it can be approved. The reviewer wrote:

> Logo does not load.

Edit your dApp in the console to address this. Saving your changes resubmits it for review.

Edit your dApp: https://console.example.test/

Sent by the NEAR Auth Console.
",
}
`;

