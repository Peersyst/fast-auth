CONFIG_ENV=development
APP_PORT=3000
# The web app's public URL. Links in emails and Slack alerts point to it.
PUBLIC_URL=http://localhost:3001
# READYZ_TIMEOUT_MS=2000
# On shutdown, /readyz answers 503 for this long before the server closes, so the load balancer stops routing first.
# SHUTDOWN_DELAY_MS=0
# One of error, warn, info, http, verbose, debug, silly. Defaults to warn when CONFIG_ENV=test and to info otherwise.
# LOG_LEVEL=info
# Optional: also writes the logs to this file.
# LOG_FILE=

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=db_database
DB_USER=db_user
DB_PASSWORD=db_password
# DB_POOL_SIZE=10
# DB_SSL=true verifies the server against Node's built-in CAs. For a private CA, set NODE_EXTRA_CA_CERTS to its bundle file.
# DB_SSL=false
# DB_CONNECT_TIMEOUT_MS=5000
# DB_LOCK_TIMEOUT_MS=10000

# Testnet tenant login; the SPA client is the console's own.
AUTH0_LOGIN_DOMAIN=login.testnet.fast-auth.com
AUTH0_CONSOLE_CLIENT_ID=
# How long a JWKS fetch may take before it counts as an outage.
# AUTH0_JWKS_TIMEOUT_MS=6000
# After a failed JWKS refetch, sessions verify with the last key set fetched for this long before the next refetch.
# AUTH0_JWKS_REFETCH_COOLDOWN_MS=30000
NEAR_NETWORK=testnet
AUTH0_PROVISIONER=fake
# AUTH0_HEALTH_CHECK_INTERVAL_MS=600000
# Only read when AUTH0_PROVISIONER=management.
AUTH0_MGMT_DOMAIN=
# The console caches the M2M token until it expires, so restart it after changing the M2M client's grant or scopes.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_TEMPLATE_CLIENT_ID=
# The wait before retrying a rate-limited or failed Management API call that sends no Retry-After, and the cap on a Retry-After.
# AUTH0_MGMT_RETRY_AFTER_MS=1000
# AUTH0_MGMT_MAX_RETRY_AFTER_MS=10000
# AUTH0_MGMT_TIMEOUT_MS=10000

EMAIL_PROVIDER=fake
# The guide the approval email links to.
# AUTHENTICATE_USERS_GUIDE_URL=https://docs.auth.near.org/home/guides/authenticate-users
# Only read when EMAIL_PROVIDER=ses. SES signs with the default AWS credential chain (a task role or the AWS_* variables).
# The app does not check those credentials at startup, so a missing one shows up as failed sends.
SES_FROM=
SES_REGION=
# SES_TIMEOUT_MS=10000
# Attempts per email, the first send included. A retry can deliver an email twice if SES had already accepted it.
# SES_MAX_ATTEMPTS=2

# Comma-separated; an admin also needs a verified email.
ADMIN_EMAILS=you@example.com

# Requests per minute each user may send to the dApp submit route, the dApp edit routes and the admin write routes.
# THROTTLE_SUBMIT_DAPP_PER_MINUTE=5
# THROTTLE_EDIT_DAPP_PER_MINUTE=10
# THROTTLE_ADMIN_MUTATION_PER_MINUTE=60

# While auto-approval is on, at most this many new submissions are chosen for it in any 24 hours.
# AUTO_APPROVAL_DAILY_CAP=10

# Optional: a Slack incoming webhook (https://hooks.slack.com/...) for admin alerts about dApp submissions; empty turns Slack off.
SLACK_WEBHOOK_URL=
# SLACK_TIMEOUT_MS=5000
