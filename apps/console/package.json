{
    "name": "console",
    "version": "0.0.0",
    "description": "NEAR Auth Console: dApp registration, review and Auth0 provisioning",
    "author": "Peersyst",
    "private": true,
    "files": [
        "dist",
        "openapi-spec.json"
    ],
    "scripts": {
        "build": "nest build && node -e \"require('node:fs').cpSync('web/dist', 'dist/public', { recursive: true })\"",
        "start": "nest start --watch",
        "clean": "rimraf .turbo coverage dist node_modules",
        "test": "jest --maxWorkers=30%",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:integration": "jest --config ./test/jest-integration.json --runInBand",
        "lint": "eslint .",
        "check-types": "npx tsc --noEmit",
        "spec": "nest build && node -r ./test/env.cjs dist/scripts/spec.js",
        "typeorm:e2e": "node -r ./test/env.cjs ./node_modules/typeorm/cli.js",
        "migration:generate": "nest build && pnpm typeorm:e2e migration:generate -d dist/database/cli-data-source.js",
        "migration:check": "nest build && pnpm typeorm:e2e schema:drop -d dist/database/cli-data-source.js && pnpm typeorm:e2e migration:run -d dist/database/cli-data-source.js && pnpm typeorm:e2e migration:generate --check -d dist/database/cli-data-source.js src/database/migrations/Drift",
        "seed": "nest build && node dist/scripts/seed.js"
    },
    "dependencies": {
        "@aws-sdk/client-sesv2": "3.1153.0",
        "@nestjs/common": "11.2.7",
        "@nestjs/config": "4.0.4",
        "@nestjs/core": "11.2.7",
        "@nestjs/platform-express": "11.2.7",
        "@nestjs/swagger": "11.4.7",
        "@nestjs/throttler": "6.7.1",
        "@nestjs/typeorm": "11.0.3",
        "@shared/console-domain": "workspace:*",
        "@willsoto/nestjs-prometheus": "6.1.1",
        "auth0": "4.37.1",
        "class-transformer": "0.5.1",
        "class-validator": "0.14.0",
        "express": "5.3.0",
        "express-openapi-validator": "5.6.2",
        "helmet": "8.3.0",
        "jose": "5.10.0",
        "nest-winston": "1.10.2",
        "pg": "8.23.1",
        "prom-client": "15.1.3",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "typeorm": "0.3.31",
        "winston": "3.19.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@nestjs/cli": "11.0.24",
        "@nestjs/testing": "11.2.7",
        "@shared/eslint": "workspace:*",
        "@shared/test": "workspace:*",
        "@shared/tsconfig": "workspace:*",
        "@types/express": "5.0.6",
        "@types/jest": "29.5.14",
        "@types/node": "22.20.5",
        "@types/supertest": "6.0.3",
        "console-web": "workspace:*",
        "eslint": "8.57.0",
        "jest": "29.7.0",
        "rimraf": "6.1.3",
        "supertest": "7.3.1",
        "ts-jest": "29.4.15",
        "typescript": "5.9.3"
    }
}
