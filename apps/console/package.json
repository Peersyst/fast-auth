{
    "name": "console",
    "version": "0.0.0",
    "description": "NEAR Auth Console: dApp registration, review and Auth0 provisioning",
    "author": "Peersyst",
    "private": true,
    "files": [
        "dist",
        "openapi-spec.json"
    ],
    "scripts": {
        "build": "nest build",
        "start": "nest start --watch",
        "clean": "rimraf .turbo coverage dist node_modules",
        "test": "jest",
        "test:e2e": "jest --config jest.e2e.config.js --runInBand",
        "lint": "eslint .",
        "check-types": "tsc --noEmit",
        "spec": "nest build && node -r dotenv/config dist/scripts/spec.js dotenv_config_path=.env.test dotenv_config_override=true",
        "typeorm:e2e": "DOTENV_CONFIG_PATH=.env.test DOTENV_CONFIG_OVERRIDE=true node -r dotenv/config ./node_modules/typeorm/cli.js",
        "migration:generate": "nest build && pnpm typeorm:e2e migration:generate -d dist/database/cli-data-source.js",
        "migration:check": "nest build && pnpm typeorm:e2e schema:drop -d dist/database/cli-data-source.js && pnpm typeorm:e2e migration:run -d dist/database/cli-data-source.js && pnpm typeorm:e2e migration:generate --check -d dist/database/cli-data-source.js src/database/migrations/Drift",
        "seed": "nest build && node dist/scripts/seed.js"
    },
    "dependencies": {
        "@aws-sdk/client-sesv2": "^3.1147.0",
        "@nestjs/common": "^10.4.20",
        "@nestjs/core": "^10.4.20",
        "@nestjs/platform-express": "^10.4.20",
        "@nestjs/swagger": "~7.1.17",
        "@nestjs/throttler": "^6.7.1",
        "@nestjs/typeorm": "^10.0.2",
        "@willsoto/nestjs-prometheus": "^6.0.2",
        "auth0": "^4.37.1",
        "class-transformer": "0.5.1",
        "class-validator": "0.14.0",
        "express": "^4.21.2",
        "express-openapi-validator": "^5.6.0",
        "helmet": "^6.2.0",
        "jose": "^5.10.0",
        "nest-winston": "^1.8.0",
        "pg": "^8.16.3",
        "prom-client": "^15.1.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "typeorm": "0.3.27",
        "winston": "^3.8.2",
        "zod": "^4.1.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.9",
        "@nestjs/testing": "^10.4.20",
        "@shared/eslint": "workspace:*",
        "@shared/tsconfig": "workspace:*",
        "@types/express": "4.17.17",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.15.30",
        "@types/supertest": "^6.0.2",
        "dotenv": "^16.4.7",
        "jest": "^29.7.0",
        "rimraf": "^6.0.1",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "typescript": "^5.7.3"
    }
}
