{
    "name": "console",
    "version": "0.0.0",
    "description": "NEAR Auth Console: dApp registration, review and Auth0 provisioning",
    "author": "Peersyst",
    "private": true,
    "files": [
        "dist",
        "openapi-spec.json"
    ],
    "scripts": {
        "build": "nest build",
        "start": "nest start --watch",
        "clean": "rimraf .turbo coverage dist node_modules",
        "test": "jest --maxWorkers=30%",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:integration": "jest --config ./test/jest-integration.json --runInBand",
        "lint": "eslint .",
        "check-types": "npx tsc --noEmit",
        "spec": "nest build && node -r ./test/env.cjs dist/scripts/spec.js",
        "typeorm:e2e": "node -r ./test/env.cjs ./node_modules/typeorm/cli.js",
        "migration:generate": "nest build && pnpm typeorm:e2e migration:generate -d dist/database/cli-data-source.js",
        "migration:check": "nest build && pnpm typeorm:e2e schema:drop -d dist/database/cli-data-source.js && pnpm typeorm:e2e migration:run -d dist/database/cli-data-source.js && pnpm typeorm:e2e migration:generate --check -d dist/database/cli-data-source.js src/database/migrations/Drift"
    },
    "dependencies": {
        "@aws-sdk/client-sesv2": "3.1152.0",
        "@nestjs/common": "11.1.19",
        "@nestjs/config": "4.0.4",
        "@nestjs/core": "11.1.19",
        "@nestjs/platform-express": "11.1.19",
        "@nestjs/swagger": "11.4.2",
        "@nestjs/throttler": "6.7.1",
        "@nestjs/typeorm": "11.0.1",
        "@shared/console-domain": "workspace:*",
        "@willsoto/nestjs-prometheus": "6.0.2",
        "auth0": "4.37.1",
        "class-transformer": "0.5.1",
        "class-validator": "0.14.0",
        "express": "5.2.1",
        "express-openapi-validator": "5.6.0",
        "helmet": "8.1.0",
        "jose": "5.10.0",
        "nest-winston": "1.10.2",
        "pg": "8.16.3",
        "prom-client": "15.1.3",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "typeorm": "0.3.27",
        "winston": "3.18.3",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@nestjs/cli": "11.0.21",
        "@nestjs/testing": "11.1.19",
        "@shared/eslint": "workspace:*",
        "@shared/test": "workspace:*",
        "@shared/tsconfig": "workspace:*",
        "@types/express": "5.0.6",
        "@types/jest": "29.5.14",
        "@types/node": "22.16.5",
        "@types/supertest": "6.0.3",
        "jest": "29.7.0",
        "rimraf": "6.0.1",
        "supertest": "7.2.2",
        "ts-jest": "29.3.4",
        "typescript": "5.7.3"
    }
}
