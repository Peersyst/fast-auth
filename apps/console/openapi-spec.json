    "info": {
        "title": "NEAR Auth Console",
        "description": "",
        "version": "1.0.0",
        "contact": {}
    },
    "tags": [],
    "servers": [],
    "components": {
        "securitySchemes": {
            "bearer": {
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "type": "http"
            }
        },
        "schemas": {
            "ErrorCode": {
                "type": "string",
                "enum": [
                    "VALIDATION_FAILED",
                    "NOT_FOUND",
                    "RATE_LIMITED",
                    "INTERNAL",
                    "UNAVAILABLE",
                    "UNAUTHENTICATED",
                    "EMAIL_REQUIRED",
                    "EMAIL_NOT_VERIFIED",
                    "FORBIDDEN_ROLE"
                ]
            },
            "ErrorDetail": {
                "type": "object",
                "properties": {
                    "field": {
                        "type": "string"
                    },
                    "constraint": {
                        "type": "string"
                    }
                },
                "required": [
                    "field",
                    "constraint"
                ]
            },
            "ErrorResponse": {
                "type": "object",
                "properties": {
                    "statusCode": {
                        "type": "number"
                    },
                    "code": {
                        "$ref": "#/components/schemas/ErrorCode"
                    },
                    "message": {
                        "type": "string"
                    },
                    "details": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ErrorDetail"
                        }
                    }
                },
                "required": [
                    "statusCode",
                    "code",
                    "message"
                ]
            },
            "Role": {
                "type": "string",
                "enum": [
                    "user",
                    "admin"
                ]
            },
            "MeResponse": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "role": {
                        "$ref": "#/components/schemas/Role"
                    },
                    "emailVerified": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "email",
                    "role",
                    "emailVerified"
                ]
            },
            "HealthResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "ok"
                        ]
                    }
                },
                "required": [
                    "status"
                ]
            },
            "ClientConfigResponse": {
                "type": "object",
                "properties": {
                    "auth0Domain": {
                        "type": "string"
                    },
                    "auth0ClientId": {
                        "type": "string"
                    },
                    "nearNetwork": {
                        "type": "string",
                        "enum": [
                            "testnet",
                            "mainnet"
                        ]
                    }
                },
                "required": [
                    "auth0Domain",
                    "auth0ClientId",
                    "nearNetwork"
                ]
            }
        }
    }
}
