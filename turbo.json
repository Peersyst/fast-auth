{
    "$schema": "https://turbo.build/schema.json",
    "concurrency": "1",
    "tasks": {
        "transit": {
            "dependsOn": ["^transit"]
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "dev": {
            "persistent": true,
            "cache": false
        },
        "test": {
            "dependsOn": ["transit"]
        },
        "clean": {
            "cache": false,
            "dependsOn": ["transit"]
        },
        "lint": {
            "dependsOn": ["transit"]
        },
        "check-types": {
            "dependsOn": ["transit"]
        },
        "bundle": {
            "dependsOn": ["^bundle"],
            "outputs": ["dist/**"]
        },
        "console-web#build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/console/openapi-spec.json"]
        },
        "console-web#check-types": {
            "dependsOn": ["transit"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/console/openapi-spec.json"]
        },
        "console-web#lint": {
            "dependsOn": ["transit"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/console/openapi-spec.json"]
        }
    }
}
