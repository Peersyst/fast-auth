    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "test": "jest --maxWorkers=30% --passWithNoTests",
        "test:coverage": "jest --coverage --passWithNoTests",
        "test:watch": "jest --watch --passWithNoTests",
        "test:debug": "jest --no-cache --runInBand --passWithNoTests",
        "clean": "rimraf .turbo dist node_modules",
        "lint": "eslint .",
        "check-types": "npx tsc --noEmit",
        "bundle": "genesys bundle"
    },
    "exports": {
        ".": "./src/index.ts",
        "./browser": "./src/browser/index.ts",
        "./providers": "./src/providers/index.ts",
        "./react": "./src/react/index.ts",
        "./mocks/core/manager": "./test/mocks/core/manager/index.ts"
    },
    "peerDependencies": {
        "@frontend/events": "workspace:*",
        "@shared/utils": "workspace:*",
        "react": "18.3.1",
        "stable-hash": "0.0.6"
    },
    "devDependencies": {
        "@frontend/events": "workspace:*",
        "@shared/eslint": "workspace:*",
        "@shared/jest-config": "workspace:*",
        "@shared/test": "workspace:*",
        "@shared/tsconfig": "workspace:*",
        "@shared/tsup": "workspace:*",
        "@shared/utils": "workspace:*",
        "@swisstype/essential": "0.1.2",
        "@types/jest": "29.5.14",
        "@types/node": "25.6.0",
        "@types/react": "18.3.12",
        "eslint": "8.57.0",
        "jest": "29.7.0",
        "react": "18.3.1",
